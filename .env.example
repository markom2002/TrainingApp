# Copy to .env and replace both values. Do not commit .env.
# SQL password: at least 12 characters with upper/lowercase, numbers and punctuation.
# Use a semicolon-free password because it is embedded in a connection string.
SQL_PASSWORD=ReplaceWithYourOwn_StrongPassword123!
JWT_KEY=ReplaceWithYourOwnRandomSigningKeyOfAtLeast32Bytes
